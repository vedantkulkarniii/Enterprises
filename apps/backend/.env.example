# Backend Environment Configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_platform_dev
DATABASE_SHADOW_URL=postgresql://postgres:postgres@localhost:5432/enterprise_platform_shadow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/microsoft/callback

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@enterpriseplatform.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# AWS S3 (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=enterprise-platform-files

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Sentry (Error Tracking)
SENTRY_DSN=

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_MFA=true
ENABLE_OAUTH=true

# Monitoring
ENABLE_MONITORING=true
METRICS_PORT=9090
